# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (PostgreSQL via Prisma) ─────────────────────────────────────────
# Local:      postgresql://user@localhost:5433/iuea_library
# Production: postgresql://user:pass@host:5432/iuea_library
DATABASE_URL=postgresql://postgres@localhost:5433/iuea_library

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-mobile-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-android-oauth-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-admin-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...


# ── Gemini AI (Google AI Studio) ──────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_VAPID_KEY=BH7Nf...

# ── Cloudflare R2 (book/audio file storage) ───────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=iuea-library-books
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ── Email — Resend (https://resend.com) ──────────────────────────────────────
# 1. Sign up at resend.com and create an API key
# 2. Add and verify your sending domain in Resend dashboard
# 3. Set FROM_EMAIL to "Your App <noreply@yourdomain.com>"
# For development you can use FROM_EMAIL=onboarding@resend.dev (Resend sandbox)
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=IUEA Library <noreply@iuea.ac.ug>
ADMIN_EMAIL=admin@iuea.ac.ug

# ── Server public URL (used for file links in emails) ─────────────────────────
SERVER_URL=http://localhost:5000

# ── CORS origins ──────────────────────────────────────────────────────────────
CLIENT_WEB_URL=http://localhost:5173
CLIENT_MOBILE_URL=http://10.0.2.2:5173
