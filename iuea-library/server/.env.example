# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (PostgreSQL via Prisma) ─────────────────────────────────────────
# Local:      postgresql://user@localhost:5433/iuea_library
# Production: postgresql://user:pass@host:5432/iuea_library
DATABASE_URL=postgresql://postgres@localhost:5433/iuea_library

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-mobile-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-android-oauth-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-admin-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...


# ── Gemini AI (Google AI Studio) ──────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_VAPID_KEY=BH7Nf...

# ── Cloudflare R2 (book/audio file storage) ───────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=iuea-library-books
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ── Email — Gmail SMTP ────────────────────────────────────────────────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Go to myaccount.google.com → Security → App Passwords
# 3. Generate a password for "Mail" → paste it as GMAIL_APP_PASSWORD
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ADMIN_EMAIL=your-gmail@gmail.com

# ── Server public URL (used for file links in emails) ─────────────────────────
SERVER_URL=http://localhost:5000

# ── CORS origins ──────────────────────────────────────────────────────────────
CLIENT_WEB_URL=http://localhost:5173
CLIENT_MOBILE_URL=http://10.0.2.2:5173
