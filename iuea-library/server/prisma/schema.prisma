generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  name                  String
  email                 String    @unique
  passwordHash          String?
  studentId             String?   @unique
  faculty               String?
  role                  String    @default("student")
  preferredLanguages    String[]  @default([])
  avatar                String?
  readingGoal           Int       @default(20)
  fcmToken              String?
  fcmTokenMobile        String?
  fcmTokenWeb           String?

  isActive              Boolean   @default(true)
  emailVerified         Boolean   @default(false)
  emailOtp              String?
  emailOtpExpiresAt     DateTime?
  loginAttempts         Int       @default(0)
  lockedUntil           DateTime?
  passwordResetToken    String?
  passwordResetExpiresAt DateTime?
  notificationPrefs     Json      @default("{}")
  readingPrefs          Json      @default("{}")
  currentStreak         Int       @default(0)
  longestStreak         Int       @default(0)
  lastReadDate          DateTime?
  totalXp               Int       @default(0)
  badges                String[]  @default([])
  totalReadingMinutes   Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  progress       UserProgress[]
  chatSessions   ChatSession[]
  collections    Collection[]
  borrowRequests BorrowRequest[]
  reviews        Review[]

  @@index([role])
  @@index([isActive])
}

model Book {
  id                 String    @id @default(cuid())

  isbn               String?
  title              String
  author             String
  description        String?
  coverUrl           String?
  fileUrl            String?
  fileKey            String?
  archiveId          String?   @unique
  gutenbergId        Int?      @unique
  fileFormat         String?
  category           String
  faculty            String[]  @default([])
  tags               String[]  @default([])
  languages          String[]  @default(["English"])
  publishedYear      Int?
  pageCount          Int?
  rating             Float     @default(0)
  ratingCount        Int       @default(0)
  isActive           Boolean   @default(true)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  progress       UserProgress[]
  borrowRequests BorrowRequest[]
  reviews        Review[]

  @@index([isActive])
  @@index([rating])
  @@index([category])
}

model UserProgress {
  id                  String    @id @default(cuid())
  userId              String
  bookId              String
  currentPage         Int       @default(0)
  currentCfi          String?
  percentComplete     Float     @default(0)
  currentChapter      Int       @default(0)
  bookmarks           Int[]     @default([])
  highlights          Json      @default("[]")
  isSaved             Boolean   @default(false)
  isDownloaded        Boolean   @default(false)
  readingLanguage     String    @default("English")
  totalReadingMinutes Int       @default(0)
  isCompleted         Boolean   @default(false)
  lastReadAt          DateTime?
  lastDevice          String    @default("web")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  messages  Json     @default("[]")
  language  String   @default("English")
  model     String   @default("gemini-1.5-flash")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Podcast {
  id              String    @id @default(cuid())
  title           String
  description     String?
  hostName        String?
  coverUrl        String?
  rssUrl          String    @unique
  category        String?
  language        String    @default("English")
  subscriberCount Int       @default(0)
  playCount       Int       @default(0)
  subscribers     String[]  @default([])
  episodes        Json      @default("[]")
  lastFetched     DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  bookIds   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model AudioCache {
  id              String    @id @default(cuid())
  bookId          String?
  textHash        String?
  chapterIndex    Int?
  language        String
  voiceLang       String?
  audioUrl        String?
  durationSeconds Int?
  generatedAt     DateTime  @default(now())
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([bookId, chapterIndex, language, voiceLang])
  @@index([textHash])
  @@index([expiresAt])
}

model BorrowRequest {
  id               String    @id @default(cuid())
  userId           String
  bookId           String
  bookTitle        String
  bookAuthor       String?
  bookCoverUrl     String?
  shelfLocation    String?
  status           String    @default("pending")
  approvedAt       DateTime?
  dueDate          DateTime?
  returnedAt       DateTime?
  adminNotes       String?
  renewalRequested Boolean   @default(false)
  renewalCount     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id])

  @@index([userId, status])
  @@index([bookId])
  @@index([dueDate, status])
}

model Review {
  id           String   @id @default(cuid())
  userId       String
  bookId       String
  rating       Int
  text         String?
  isVerified   Boolean  @default(false)
  helpfulVotes String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}
